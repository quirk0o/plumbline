DATABASE_URL="postgresql://user:password@localhost:5432/simtrack?schema=public"

# Set to your app's canonical URL in production (e.g. https://simtrack.example.com)
AUTH_URL=http://localhost:3000

# Generate with: npx auth secret
AUTH_SECRET=

# From Google Cloud Console (OAuth 2.0 credentials)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# From resend.com dashboard
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Object storage (S3-compatible: MinIO in dev, Cloudflare R2 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="simtrack-dev"
